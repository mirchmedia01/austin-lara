APP_NAME="Austin Optics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://austinoptics.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail — Resend (sending domain: mail.sprintmediadesign.com)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@mail.sprintmediadesign.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

ADMIN_EMAILS=abdullah.saeed1724@gmail.com,marketing@mirchmedia.com,austinoptics@gmail.com
ADMIN_PASSWORD=

# GTM_ID=

